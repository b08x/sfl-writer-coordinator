{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "document_revision": {
      "type": "string",
      "minLength": 1
    },
    "repository_revision": {
      "type": "string",
      "minLength": 1
    },
    "draft_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "const": "evidence"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "BLOCKED"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "Scout",
        "Verify",
        "Auditor"
      ]
    },
    "graph": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "type": "string",
          "minLength": 1
        },
        "repository_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "generation",
        "freshness",
        "repository_revision"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "pages_complete": {
            "type": "boolean"
          },
          "pagination": {
            "type": "object"
          }
        },
        "required": [
          "tool",
          "arguments",
          "pages_complete",
          "pagination"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_ranges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "checked",
        "paths",
        "state",
        "fallback",
        "unresolved_ranges"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "source",
              "graph",
              "test_definition",
              "test_result",
              "benchmark",
              "runtime_trace"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "kind",
          "location",
          "excerpt",
          "claim_ids"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "supported",
              "contradicted",
              "unsupported",
              "untested"
            ]
          },
          "treatment": {
            "enum": [
              "asserted",
              "qualified",
              "omitted"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_type": {
            "enum": [
              "positive",
              "negative",
              "exhaustive"
            ]
          }
        },
        "required": [
          "claim_id",
          "classification",
          "treatment",
          "evidence_refs",
          "claim_type"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "task_id",
    "document_revision",
    "repository_revision",
    "draft_sha256",
    "phase",
    "status",
    "project",
    "tier",
    "graph",
    "scope",
    "queries",
    "coverage",
    "evidence",
    "claims",
    "assumptions",
    "blockers"
  ],
  "additionalProperties": false
}
